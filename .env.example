# Public origin of the deployment (canonical URL, sitemap, robots, social tags).
# Required for production builds; Vercel deployments fall back to
# VERCEL_PROJECT_PRODUCTION_URL when this is unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Self-hosting only: set to "cloudflare" ONLY when every request arrives through
# Cloudflare. Otherwise cf-connecting-ip is client-controlled.
# TRUSTED_PROXY_MODE=cloudflare
