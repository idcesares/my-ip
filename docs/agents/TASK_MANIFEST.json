{
  "schemaVersion": 1,
  "project": "my-ip-reference",
  "runtime": {
    "framework": "Next.js App Router",
    "language": "TypeScript",
    "hosting": "Vercel"
  },
  "truthOrder": ["src-and-tests", "docs/project", "docs/agents"],
  "phases": [
    {
      "id": "inspect",
      "requires": [],
      "actions": [
        "read-agent-rules",
        "inspect-git-status",
        "query-code-graph-if-available",
        "read-relevant-tests-and-docs"
      ]
    },
    {
      "id": "implement",
      "requires": ["inspect"],
      "actions": [
        "preserve-privacy-invariants",
        "add-tests",
        "make-scoped-change",
        "update-user-facing-copy"
      ]
    },
    {
      "id": "document",
      "requires": ["implement"],
      "actions": ["update-readme", "update-project-docs", "update-changelog"]
    },
    {
      "id": "validate",
      "requires": ["document"],
      "commands": [
        "npm run typecheck",
        "npm run lint",
        "npm run test:coverage",
        "npm run build",
        "npm run test:smoke",
        "npm run format",
        "npm audit --audit-level=high"
      ]
    },
    {
      "id": "handoff",
      "requires": ["validate"],
      "actions": [
        "browser-check-desktop-and-mobile",
        "refresh-code-graph",
        "report-results-and-remaining-operational-boundaries"
      ]
    }
  ],
  "invariants": [
    "no-analytics",
    "no-application-database",
    "local-history-only",
    "no-diagnostic-permission-prompts",
    "webrtc-opt-in",
    "cache-disabled-api",
    "vercel-waf-for-production-abuse-control",
    "honest-measurement-language"
  ]
}
